APP_NAME=VirgoZone
VIRGOZONE_HOST=0.0.0.0
VIRGOZONE_PORT=8080
DATA_DIR=/home/jetson/fairy_lan/data
ADMIN_PASSWORD=neuro
ADMIN_SESSION_SECONDS=28800
IMAGE_MAX_MB=20
VIDEO_MAX_MB=250
MIN_FREE_MB=1024
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_VISION_MODEL=moondream:1.8b
OLLAMA_VISION_ENABLED=false
OLLAMA_TIMEOUT_SECONDS=45
FAIRY_AUTO_COMMENT=false
HOSAKA_IDENTITY_DIR=/home/jetson/Hosaka/identity

# Citations wall (/citations). VirgoZone drives the halloween-citations extension
# API from its checkout and keeps its own replica under DATA_DIR/citations.
# Publishable/anon key only; secret keys are refused. Sign in once with
# `python -m app.citations_login` (password prompted, never stored).
CITATIONS_SOURCE=/home/jetson/hosaka_citations
CITATIONS_SUPABASE_URL=https://your-project.supabase.co
CITATIONS_PUBLISHABLE_KEY=sb_publishable_...
CITATIONS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
CITATIONS_SYNC_ENABLED=true
CITATIONS_SYNC_INTERVAL_SECONDS=60
CITATIONS_ALLOW_NETWORK=true
# Let unauthenticated guests issue citations / complete remedies from the wall.
CITATIONS_PUBLIC_WRITE=false
# Set the same value as the citations.hosaka.xyz gate's CITATIONS_GATE_TOKEN to refuse
# direct non-loopback access to /citations and /api/citations/*.
CITATIONS_GATE_TOKEN=
