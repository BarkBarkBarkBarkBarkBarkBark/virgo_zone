[Unit]
Description=VirgoZone local social site
After=local-fs.target network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/fairy_lan
Environment=PYTHONUNBUFFERED=1
Environment=VIRGOZONE_HOST=0.0.0.0
Environment=VIRGOZONE_PORT=8080
EnvironmentFile=-/etc/virgozone/env
ExecStart=/home/jetson/fairy_lan/.venv/bin/uvicorn app.main:app --app-dir /home/jetson/fairy_lan/web/local --host 0.0.0.0 --port 8080 --workers 1 --log-level info
Restart=always
RestartSec=3
TimeoutStopSec=20
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# data/ includes data/citations/ (citations replica + organizer session).
ReadWritePaths=/home/jetson/fairy_lan/data
MemoryHigh=700M
MemoryMax=900M
TasksMax=128

[Install]
WantedBy=multi-user.target
